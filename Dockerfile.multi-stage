FROM rust:1.93 AS builder

WORKDIR /agent

COPY . .
RUN apt-get update && apt-get install -y musl-tools && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl
RUN cargo build -r --bin tat_agent --target=x86_64-unknown-linux-musl

FROM ubuntu:22.04 AS ship

ENV TZ=Asia/Shanghai

WORKDIR /usr/local/bin

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /agent/target/x86_64-unknown-linux-musl/release/tat_agent .

ENTRYPOINT ["./tat_agent", "--console-log", "--no-daemon"]
